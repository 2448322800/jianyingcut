# ── 服务端 ───────────────────────────────────────────────
# 监听地址。默认只绑本机，避免局域网暴露。
HOST=127.0.0.1
PORT=4000

# 允许的跨域来源，逗号分隔。生产环境禁止使用 * 。
# 5173 是开发时 Vite 的地址；4000 是「构建后由后端一起托管」的单端口模式。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# 素材与工程状态的落盘目录（相对仓库根目录，也可写绝对路径）
MEDIA_DIR=server/media
DATA_DIR=server/data

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 单次上传大小上限（字节）。默认 2 GiB。
MAX_UPLOAD_BYTES=2147483648

# 允许「按路径原地导入」的根目录白名单，逗号分隔。$HOME 会被展开。
# 这是安全边界：POST /api/assets/import 能读磁盘上的文件，不设白名单等于开放整个文件系统。
# 默认只放开 WorkBuddy 工作区（项目都在那儿）。要导入别处的素材就加进来，例如：
#   IMPORT_ROOTS=$HOME/WorkBuddy,$HOME/Desktop/04 素材库
IMPORT_ROOTS=$HOME/WorkBuddy

# ── 前端（写在 web/.env 里） ──────────────────────────────
# 后端地址。不设置时代码回退到 http://127.0.0.1:4000
# VITE_API_BASE_URL=http://127.0.0.1:4000
